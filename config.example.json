{
    "_comment": "这是 config.json 模板. 首次运行后会自动复制为 config.json, 在 UI 里改 llama_dir 和 model 路径, 或手动编辑.",

    "llama_dir": "C:\\\\llama.cpp",
    "host": "0.0.0.0",
    "port": 8080,
    "models_max": 1,
    "sleep_idle_seconds": 3600,

    "watchdog": {
        "enabled": false,
        "free_mb_threshold": 2048,
        "check_interval_seconds": 10,
        "min_idle_seconds": 0
    },

    "models": [
        {
            "_comment_fields": "id 必填; model 必填 (绝对路径); mmproj/base_url/api_key/draft_* 都可选",
            "id": "my-model",
            "alias": "m",
            "model": "C:\\\\path\\\\to\\\\your-model.gguf",
            "mmproj": "",
            "base_url": "",
            "api_key": "",
            "draft_model": "",
            "draft_type": "",
            "draft_n_max": 3,
            "draft_n_min": 0,
            "draft_p_split": 0.1,
            "draft_p_min": 0.0,
            "draft_ngl": "auto",
            "enabled": true,
            "params": {}
        }
    ]
}
